{
  "name": "qq-agent",
  "version": "0.4.4",
  "private": false,
  "description": "QQ 群 AI 机器人（桌面版）：事件驱动的无状态 Agent，接 OpenAI 兼容 API，带会话式控制台。",
  "type": "module",
  "main": "electron/main.js",
  "license": "MIT",
  "author": {
    "name": "Kondius",
    "url": "https://github.com/Kondius/qq-agent"
  },
  "//authorNote": "原作者是 Kondius（MIT）。这里保留其署名与 URL，符合 MIT 的版权声明保留要求。没有臆造其邮箱。",
  "maintainer": {
    "name": "prolet1966",
    "email": "hs75311a@126.com"
  },
  "//maintainerNote": "maintainer 指「这个 re-packaged 的 Linux 包由谁维护、问题反馈给谁」——即本项目。electron-builder 生成 .deb 时必须要有 maintainer 邮箱，缺失会直接报错：'Please specify author email in the application package.json. It is required to set Linux .deb package maintainer.'",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "electron .",
    "server": "node src/server.js",
    "test": "node test/platform-test.mjs",
    "test:platform": "node test/platform-test.mjs",
    "dist:linux": "electron-builder --linux deb rpm AppImage --x64",
    "dist:deb": "electron-builder --linux deb --x64",
    "dist:rpm": "electron-builder --linux rpm --x64",
    "dist:appimage": "electron-builder --linux AppImage --x64",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "js-yaml": "^5.4.1",
    "undici": "^6.28.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "^26.15.3"
  },
  "//electronVersionNote": "electron 必须写精确版本，不能用 ^ 范围。原因：electron-builder 需要在打包时下载『该平台对应的 Electron 二进制』，范围无法解析出唯一版本。原版写 ^33.2.0，实测报错：'Electron version \"^33.2.0\" is a range, not a fixed version.' 修复方式二选一：这里写死精确版本，或在 build 里显式设 electronVersion。",
  "build": {
    "appId": "cn.kondius.qq-agent",
    "productName": "QQ Agent",
    "asar": true,
    "asarUnpack": [
      "snowluma/**"
    ],
    "files": [
      "**/*",
      "!data/**",
      "!data-*/**",
      "!snowluma/data/**",
      "!snowluma/logs/**",
      "!snowluma/config.auto-*/**",
      "!**/*.log",
      "!**/*.map",
      "!test/**",
      "!doc/**",
      "!scripts/**",
      "!build-scripts/**",
      "!dist/**",
      "!**/*.bak-*",
      "!task_plan.md",
      "!findings.md",
      "!progress*.md",
      "!package-lock.json.bak"
    ],
    "linux": {
      "target": [
        { "target": "deb", "arch": ["x64"] },
        { "target": "rpm", "arch": ["x64"] },
        { "target": "AppImage", "arch": ["x64"] }
      ],
      "category": "Network",
      "icon": "assets/icon.png",
      "artifactName": "qq-agent-v${version}-${arch}.${ext}",
      "synopsis": "QQ 群 AI 机器人（基于 OneBot v11 与 SnowLuma）",
      "description": "事件驱动的 QQ 群 AI 机器人。内置 SnowLuma 协议端与 Electron 运行时，接 OpenAI 兼容 API。数据目录遵循 XDG 规范存放在用户主目录。",
      "maintainer": "prolet1966 <hs75311a@126.com>",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "QQ Agent",
          "Comment": "QQ 群 AI 机器人控制台",
          "Categories": "Network;InstantMessaging;Utility;",
          "StartupWMClass": "QQ Agent"
        }
      }
    },
    "deb": {
      "depends": [
        "libnss3",
        "libgtk-3-0",
        "libasound2",
        "libgbm1",
        "libxkbcommon0",
        "libdrm2",
        "libxss1",
        "xdg-utils"
      ],
      "recommends": [
        "fonts-noto-cjk",
        "xvfb"
      ],
      "priority": "optional"
    },
    "rpm": {
      "depends": [
        "nss",
        "gtk3",
        "alsa-lib",
        "mesa-libgbm",
        "libxkbcommon",
        "libdrm",
        "libXScrnSaver",
        "xdg-utils"
      ]
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "qq-agent-v${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "QQ Agent"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kondius/qq-agent.git"
  },
  "bugs": {
    "url": "https://github.com/Kondius/qq-agent/issues"
  },
  "homepage": "https://github.com/Kondius/qq-agent#readme",
  "keywords": [
    "qq",
    "bot",
    "agent",
    "openai",
    "onebot",
    "snowluma",
    "llm",
    "desktop",
    "electron",
    "linux"
  ]
}
