// Replace @USER@ before installing as root into /etc/polkit-1/rules.d/50-qq-agent-components.rules (0644 root:root).
// Optional: leave absent when component controls should be read-only.
polkit.addRule(function(action, subject) {
  if (subject.user !== "@USER@" || action.id !== "org.freedesktop.systemd1.manage-units") return;
  var unit = action.lookup("unit"), verb = action.lookup("verb");
  if ((unit === "qq-agent-qq.service" || unit === "qq-agent-snowluma.service" || unit === "qq-agent-desktop.service") && (verb === "start" || verb === "stop" || verb === "restart")) return polkit.Result.YES;
});
